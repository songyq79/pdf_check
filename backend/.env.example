# 多环境配置示例
# .env 文件：本地开发环境（DEBUG=True，Redis 默认配置）
# .env.production 文件：线上生产环境（DEBUG=False，阿里云配置）
#
# 环境选择通过 APP_ENV 环境变量控制：
#   APP_ENV=development  (默认，加载 .env)
#   APP_ENV=production   (加载 .env.production)

# ── AI 服务（至少配置一个）────────────────────────────────
BAILIAN_API_KEY=your_bailian_api_key_here
BAILIAN_MODEL=qwen-max
BAILIAN_TIMEOUT=60

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# ── 数据库 ────────────────────────────────────────────────
# 本地开发：留空使用 SQLite（./storage/app.db）
# 生产环境：根据实际数据库配置修改
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/paper_check

# ── Redis ─────────────────────────────────────────────────
# 本地开发默认值（无密码）
CELERY_BROKER_URL=redis://:jzmNDJAF7b@localhost:26301/15
CELERY_RESULT_BACKEND=redis://:jzmNDJAF7b@localhost:26301/15
REDIS_HOST=localhost
REDIS_PORT=26301
REDIS_DB=15
REDIS_PASSWORD=jzmNDJAF7b

# 生产环境（阿里云宝塔示例）
# REDIS_HOST=localhost
# REDIS_PORT=26301
# REDIS_DB=15
# REDIS_PASSWORD=your_redis_password

# ── Celery ────────────────────────────────────────────────
# 本地开发
CELERY_BROKER_URL=redis://:jzmNDJAF7b@localhost:26301/15
CELERY_RESULT_BACKEND=redis://:jzmNDJAF7b@localhost:26301/15

# 生产环境（阿里云宝塔示例）
# CELERY_BROKER_URL=redis://:password@localhost:26301/15
# CELERY_RESULT_BACKEND=redis://:password@localhost:26301/15

# ── 应用配置 ──────────────────────────────────────────────
DEBUG=True
USE_AI=False
MAX_FILE_SIZE=20
FILE_RETENTION_HOURS=24
LOG_LEVEL=INFO
PLAGIARISM_ENGINE=hybrid

# ── 安全 ──────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-a-long-random-string

# ── 微信支付配置 ───────────────────────────────────────────
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_CERT_SERIAL_NO=
WECHAT_PRIVATE_KEY_PATH=wechat/apiclient_key.pem
WECHAT_PUBLIC_KEY_PATH=wechat/pub_key.pem
WECHAT_PUBLIC_KEY_ID=
WECHAT_NOTIFY_URL=

# ── 支付宝配置 ─────────────────────────────────────────────
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY_PATH=alipay/private_key.pem
ALIPAY_PUBLIC_KEY_PATH=alipay/public_key.pem
ALIPAY_NOTIFY_URL=

# ── 阿里云短信配置 ─────────────────────────────────────────
ALIYUN_SMS_ACCESS_KEY=
ALIYUN_SMS_ACCESS_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# ── 微信开放平台配置 ───────────────────────────────────────
WECHAT_LOGIN_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=

# ── 英文论文查重 API 配置 ──────────────────────────────────
# CORE API - 用于搜索已发表论文和学术资源
CORE_API_KEY=your_core_api_key_here
CORE_BASE_URL=https://api.core.ac.uk/v3
CORE_TIMEOUT=15

# Semantic Scholar API - 用于论文元数据和引用关系查询
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here
SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org/graph/v1
SEMANTIC_SCHOLAR_TIMEOUT=10
